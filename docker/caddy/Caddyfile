:80 {
    root * /var/www/html/public
    encode zstd gzip

    php_fastcgi app:9000
    file_server

    @blocked path /.env /composer.* /package*.json /vite.config.* /storage/*
    respond @blocked 404

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}
