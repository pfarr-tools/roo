#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  bootstrap)
    exec ./scripts/bootstrap.sh "$@"
    ;;
  up)
    docker compose up -d "$@"
    ;;
  down)
    docker compose down "$@"
    ;;
  restart)
    docker compose restart "$@"
    ;;
  status|ps)
    docker compose ps "$@"
    ;;
  logs)
    docker compose logs -f "$@"
    ;;
  shell)
    exec docker compose exec app bash "$@"
    ;;
  artisan)
    exec docker compose exec -e XDG_CONFIG_HOME=/tmp/config app php artisan "$@"
    ;;
  data)
    DATA_COMMAND="${1:-help}"
    shift || true
    case "$DATA_COMMAND" in
      push|pull)
        exec "$ROOT/scripts/data-sync.sh" "$DATA_COMMAND" "$@"
        ;;
      help)
        exec "$ROOT/scripts/data-sync.sh" help
        ;;
      *)
        echo "Unbekannter Datenbefehl: $DATA_COMMAND" >&2
        echo "Verwendung: ./roo data push <ssh-path> oder ./roo data pull <ssh-path>" >&2
        exit 2
        ;;
    esac
    ;;
  composer)
    exec docker compose exec app composer "$@"
    ;;
  npm)
    exec docker compose run --rm vite npm "$@"
    ;;
  pint)
    exec docker compose exec app ./vendor/bin/pint "$@"
    ;;
  test)
    exec docker compose exec \
      -e APP_ENV=testing \
      -e DB_CONNECTION=sqlite \
      -e DB_DATABASE=:memory: \
      -e APP_KEY='base64:MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=' \
      app php artisan test "$@"
    ;;
  prod|production)
    PROD_COMMAND="${1:-help}"
    shift || true
    case "$PROD_COMMAND" in
      install)
        exec "$ROOT/scripts/install-production.sh" "$@"
        ;;
      update)
        exec "$ROOT/scripts/update-production.sh" "$@"
        ;;
      status|ps)
        exec docker compose -f "$ROOT/compose.production.yaml" ps "$@"
        ;;
      up)
        exec docker compose -f "$ROOT/compose.production.yaml" up -d "$@"
        ;;
      down)
        exec docker compose -f "$ROOT/compose.production.yaml" down "$@"
        ;;
      restart)
        exec docker compose -f "$ROOT/compose.production.yaml" restart "$@"
        ;;
      logs)
        exec docker compose -f "$ROOT/compose.production.yaml" logs -f "$@"
        ;;
      exec)
        exec docker compose -f "$ROOT/compose.production.yaml" exec "$@"
        ;;
      compose)
        exec docker compose -f "$ROOT/compose.production.yaml" "$@"
        ;;
      help)
        cat <<'EOF'
Produktionsbefehle

Verwendung:
  ./roo prod install
  ./roo prod update --backup-confirmed [--ref <tag|commit>]
  ./roo prod up [dienst ...]
  ./roo prod down
  ./roo prod restart [dienst ...]
  ./roo prod status
  ./roo prod logs [dienst]
  ./roo prod exec <dienst> <befehl>
  ./roo prod compose <docker-compose-befehl> [argumente ...]

Die Produktionsbefehle verwenden compose.production.yaml.
Die übrigen ./roo-Befehle sind Entwicklungsbefehle.
EOF
        ;;
      *)
        echo "Unbekannter Produktionsbefehl: $PROD_COMMAND" >&2
        exit 2
        ;;
    esac
    ;;
  fresh)
    if [[ "${1:-}" != "--force" ]]; then
      echo "Abbruch: ./roo fresh löscht die normale lokale Datenbank."
      echo "Nur bewusst ausführen mit: ./roo fresh --force"
      exit 2
    fi
    shift
    exec docker compose exec app php artisan migrate:fresh --seed --force "$@"
    ;;
  *)
    cat <<'EOF'
Roo-Entwicklungshelfer

Verwendung:
  ./roo bootstrap
  ./roo up
  ./roo down
  ./roo restart
  ./roo status
  ./roo logs [dienst]
  ./roo shell
  ./roo artisan <befehl>
  ./roo data push <ssh-path> [--source-down]
  ./roo data pull <ssh-path> [--source-down]
  ./roo composer <befehl>
  ./roo npm <befehl>
  ./roo pint
  ./roo test
  ./roo fresh
  ./roo prod install
  ./roo prod update --backup-confirmed [--ref <tag|commit>]
  ./roo prod status
  ./roo prod logs [dienst]
EOF
    ;;
esac
