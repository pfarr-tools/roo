{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roo Confessional Cooperative Curriculum 1.1",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "metadata",
    "education_plan_bindings",
    "units"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "type": {
      "const": "confessional_cooperative_curriculum"
    },
    "metadata": {
      "type": "object"
    },
    "education_plan_bindings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "preparation_questions",
          "shared_plan",
          "denominational_profiles",
          "process_competencies",
          "raw_rows"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "hours": {
            "type": [
              "number",
              "null"
            ]
          },
          "preparation_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shared_plan": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "denominational_profiles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "content_competencies",
                "perspective"
              ],
              "properties": {
                "content_competencies": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "number",
                      "denomination",
                      "text",
                      "raw"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "number": {
                        "type": "integer"
                      },
                      "denomination": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "raw": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "perspective": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "process_competencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "denomination",
                "text",
                "raw"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "denomination": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "raw": {
                  "type": "string"
                },
                "source_formatting": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            }
          },
          "raw_rows": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
